[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scenes/screens/daily_screen.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://scenes/ui/screen_background.tscn" id="2_background"]
[ext_resource type="Texture2D" path="res://assets/icons/back.svg" id="3_back"]
[ext_resource type="Script" path="res://scenes/board/board_view.gd" id="4_board"]

[node name="DailyScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="ScreenBackground" parent="." instance=ExtResource("2_background")]
layout_mode = 1

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 48
theme_override_constants/margin_top = 40
theme_override_constants/margin_right = 48
theme_override_constants/margin_bottom = 40

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="TopRow" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="BackButton" type="Button" parent="Margin/Layout/TopRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(88, 88)
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Back"
theme_type_variation = &"IconButton"
icon = ExtResource("3_back")
icon_alignment = 1
expand_icon = true

[node name="Heading" type="VBoxContainer" parent="Margin/Layout/TopRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = -4
alignment = 1

[node name="Title" type="Label" parent="Margin/Layout/TopRow/Heading"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
theme_override_font_sizes/font_size = 42
text = "DAILY CHALLENGE"

[node name="DateLabel" type="Label" parent="Margin/Layout/TopRow/Heading"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CaptionLabel"
text = "Tuesday, 24 November"

[node name="PuzzleCard" type="PanelContainer" parent="Margin/Layout"]
layout_mode = 2
size_flags_vertical = 3
theme_type_variation = &"CardPanel"

[node name="Content" type="VBoxContainer" parent="Margin/Layout/PuzzleCard"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Preview" type="Control" parent="Margin/Layout/PuzzleCard/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 200)
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2
script = ExtResource("4_board")

[node name="PuzzleTitle" type="Label" parent="Margin/Layout/PuzzleCard/Content"]
layout_mode = 2
theme_type_variation = &"HeadingLabel"
text = "Today's puzzle"
horizontal_alignment = 1

[node name="StatusLabel" type="Label" parent="Margin/Layout/PuzzleCard/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CaptionLabel"
text = "The same board for every player today."
horizontal_alignment = 1
autowrap_mode = 3

[node name="PlayButton" type="Button" parent="Margin/Layout/PuzzleCard/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 104)
layout_mode = 2
theme_type_variation = &"PrimaryButton"

[node name="PlayLabel" type="Label" parent="Margin/Layout/PuzzleCard/Content/PlayButton"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"TitleLabel"
theme_override_colors/font_color = Color(0.165, 0.114, 0.02, 1)
theme_override_font_sizes/font_size = 36
text = "PLAY TODAY'S PUZZLE"
horizontal_alignment = 1
vertical_alignment = 1

[node name="CountdownLabel" type="Label" parent="Margin/Layout/PuzzleCard/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CaptionLabel"
theme_override_colors/font_color = Color(0.49, 0.529, 0.604, 1)
text = "New puzzle in 9 h 12 min"
horizontal_alignment = 1

[node name="StreakCard" type="PanelContainer" parent="Margin/Layout"]
layout_mode = 2
theme_type_variation = &"CardPanel"

[node name="Content" type="VBoxContainer" parent="Margin/Layout/StreakCard"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Header" type="HBoxContainer" parent="Margin/Layout/StreakCard/Content"]
layout_mode = 2

[node name="StreakLabel" type="Label" parent="Margin/Layout/StreakCard/Content/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"OverlineLabel"
theme_override_colors/font_color = Color(0.933, 0.945, 0.965, 1)
theme_override_font_sizes/font_size = 26
text = "0-DAY STREAK"

[node name="BestLabel" type="Label" parent="Margin/Layout/StreakCard/Content/Header"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"OverlineLabel"
theme_override_colors/font_color = Color(0.435, 0.839, 0.784, 1)
text = "Best: 0"

[node name="WeekRow" type="HBoxContainer" parent="Margin/Layout/StreakCard/Content"]
unique_name_in_owner = true
layout_mode = 2

[node name="LeaderboardCard" type="PanelContainer" parent="Margin/Layout"]
layout_mode = 2
theme_type_variation = &"CardPanel"

[node name="Content" type="VBoxContainer" parent="Margin/Layout/LeaderboardCard"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Header" type="HBoxContainer" parent="Margin/Layout/LeaderboardCard/Content"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="Margin/Layout/LeaderboardCard/Content/Header"]
layout_mode = 2
text = "Leaderboards"

[node name="Tag" type="Label" parent="Margin/Layout/LeaderboardCard/Content/Header"]
layout_mode = 2
theme_type_variation = &"OverlineLabel"
theme_override_colors/font_color = Color(0.788, 0.816, 0.863, 1)
text = "LATER UPDATE"

[node name="Caption" type="Label" parent="Margin/Layout/LeaderboardCard/Content"]
layout_mode = 2
