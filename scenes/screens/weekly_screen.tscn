[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scenes/screens/weekly_screen.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://scenes/ui/screen_background.tscn" id="2_background"]
[ext_resource type="Texture2D" path="res://assets/icons/back.svg" id="3_back"]
[ext_resource type="Texture2D" path="res://assets/icons/badge_locked.svg" id="4_badge"]

[node name="WeeklyScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="ScreenBackground" parent="." instance=ExtResource("2_background")]
layout_mode = 1

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 48
theme_override_constants/margin_top = 40
theme_override_constants/margin_right = 48
theme_override_constants/margin_bottom = 48

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="TopRow" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="BackButton" type="Button" parent="Margin/Layout/TopRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(88, 88)
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Back"
theme_type_variation = &"IconButton"
icon = ExtResource("3_back")
icon_alignment = 1
expand_icon = true

[node name="Heading" type="VBoxContainer" parent="Margin/Layout/TopRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = -4
alignment = 1

[node name="Title" type="Label" parent="Margin/Layout/TopRow/Heading"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
theme_override_font_sizes/font_size = 42
text = "WEEKLY CHALLENGE"

[node name="RangeLabel" type="Label" parent="Margin/Layout/TopRow/Heading"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CaptionLabel"
theme_override_colors/font_color = Color(0.49, 0.529, 0.604, 1)
text = "NOV 23 – NOV 29 · 5 days left"

[node name="Intro" type="Label" parent="Margin/Layout"]
layout_mode = 2
theme_type_variation = &"CaptionLabel"
text = "Five puzzles for everyone this week, each harder than the last. Play them in any order."
autowrap_mode = 3

[node name="ListCard" type="PanelContainer" parent="Margin/Layout"]
layout_mode = 2
theme_type_variation = &"CardPanel"

[node name="List" type="VBoxContainer" parent="Margin/Layout/ListCard"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 0

[node name="Spacer" type="Control" parent="Margin/Layout"]
layout_mode = 2
size_flags_vertical = 3

[node name="SealCard" type="PanelContainer" parent="Margin/Layout"]
layout_mode = 2
theme_type_variation = &"CardPanel"

[node name="Row" type="HBoxContainer" parent="Margin/Layout/SealCard"]
layout_mode = 2
theme_override_constants/separation = 22

[node name="SealIcon" type="TextureRect" parent="Margin/Layout/SealCard/Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(72, 72)
layout_mode = 2
size_flags_vertical = 4
texture = ExtResource("4_badge")
expand_mode = 1
stretch_mode = 5

[node name="Text" type="VBoxContainer" parent="Margin/Layout/SealCard/Row"]
layout_mode = 2
size_flags_horizontal = 3
alignment = 1

[node name="SealTitle" type="Label" parent="Margin/Layout/SealCard/Row/Text"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"OverlineLabel"
text = "WEEKLY SEAL · 0 / 5"

[node name="SealCaption" type="Label" parent="Margin/Layout/SealCard/Row/Text"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CaptionLabel"
text = "Solve all 5 puzzles this week."
autowrap_mode = 3
